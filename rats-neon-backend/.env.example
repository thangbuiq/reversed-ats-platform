# =============================
# Neon (required)
# =============================
# Use the pooled connection string (host contains "-pooler") from the Neon console.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
JOB_RETENTION_DAYS=30

# =============================
# Qdrant (optional, CV matching only)
# =============================
# Leave empty to skip vector sync entirely.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=linkedin_jobs

# =============================
# Scrape Config
# =============================
SEARCH_TERMS=["Data Engineer", "Data Analyst", "Data Scientist", "AI Engineer", "Software Engineer", "DevOps Engineer"]
SITE_NAMES=linkedin
JOB_LOCATION="Ho Chi Minh City, Vietnam"
RESULTS_WANTED=50
HOURS_OLD=24
LINKEDIN_FETCH_DESCRIPTION=true
LOG_LEVEL=INFO
